    {
      "id": "crear-solicitud",
      "module": "routes/solicitud_routes.py",
      "method": "POST",
      "path": "/api/solicitudes",
      "objective": "Validar creación concurrente de solicitudes de prueba",
      "priority": "P0",
      "traffic_weight": 10,
      "auth_role": "client",
      "mutates_data": true,
      "enabled_profiles": ["smoke", "load", "stress", "spike"]
