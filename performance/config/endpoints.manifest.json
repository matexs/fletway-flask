      "priority": "P0",
      "traffic_weight": 10,
      "auth_role": "driver",
      "mutates_data": false,
      "enabled_profiles": ["load", "stress", "spike"]
    },
    {
      "id": "presupuestos-solicitud",
      "module": "routes/presupuesto_routes.py",
      "method": "GET",
      "path": "/api/presupuestos/solicitud/<solicitud_id>",
