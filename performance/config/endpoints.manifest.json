{
  "version": 1,
  "campaign": "requested-solicitudes-presupuestos",
  "endpoints": [
    {
      "id": "presupuestos-completo-batch",
      "module": "routes/presupuesto_routes.py",
      "method": "GET",
      "path": "/api/presupuestos/completo-batch",
      "objective": "Validar presupuestos agrupados del cliente bajo carga concurrente",
      "priority": "P0",
      "traffic_weight": 10,
      "auth_role": "client",
      "mutates_data": false,
      "enabled_profiles": ["load", "stress", "spike"]
    },
    {
      "id": "mis-presupuestos",
      "module": "routes/presupuesto_routes.py",
      "method": "GET",
      "path": "/api/presupuestos/mis-presupuestos",
